{
  "ops_enabled": {
    "appimage": true,
    "launch_desktop": true,
    "dissolve_folder": true,
    "move_into_folder": true,
    "admin": true,
    "admin_run": true,
    "copy": true,
    "open_ide": true,
    "open_terminal": true,
    "checksum": true
  },
  "language": "auto",
  "log_level": "WARNING",
  "separator": "\n",
  "copy": {
    "item": {
      "copy_path": {
        "enabled": true,
        "shortcut": "<Ctrl><Shift>C"
      },
      "copy_uri": {
        "enabled": true,
        "shortcut": "<Ctrl><Shift>U"
      },
      "copy_name": {
        "enabled": true,
        "shortcut": "<Ctrl><Shift>D",
        "ignore_extension": false
      },
      "copy_content": {
        "enabled": true,
        "shortcut": "<Ctrl><Shift>G"
      }
    },
    "collapse_menu": true,
    "selections": {
      "clipboard": true,
      "primary": true
    },
    "escape_value_items": false,
    "escape_value": false
  },
  "open_ide": {
    "exclude_mime": [],
    "other_ides": {
      "Visual Studio Code": {
        "enabled": true,
        "cmd": ["code"],
        "flatpak": ["com.visualstudio.code"]
      },
      "Visual Studio Code - Insiders": {
        "enabled": true,
        "cmd": ["code-insiders"],
        "flatpak": ["com.visualstudio.code.insiders"]
      },
      "Code - OSS": {
        "enabled": true,
        "cmd": ["code-oss"],
        "flatpak": []
      },
      "Zed": {
        "enabled": true,
        "cmd": ["zed"],
        "flatpak": ["dev.zed.Zed"]
      }
    },
    "jetbrains_ides": {
      "collapse_menu": false,
      "IntelliJ IDEA": {
        "enabled": true,
        "cmd": ["idea"],
        "flatpak": ["com.jetbrains.IntelliJ-IDEA-Ultimate"]
      },
      "PyCharm": {
        "enabled": true,
        "cmd": ["pycharm"],
        "flatpak": ["com.jetbrains.PyCharm-Professional"]
      },
      "WebStorm": {
        "enabled": true,
        "cmd": ["webstorm"],
        "flatpak": ["com.jetbrains.WebStorm"]
      },
      "CLion": {
        "enabled": true,
        "cmd": ["clion"],
        "flatpak": ["com.jetbrains.CLion"]
      },
      "GoLand": {
        "enabled": true,
        "cmd": ["goland"],
        "flatpak": ["com.jetbrains.GoLand"]
      },
      "Rider": {
        "enabled": true,
        "cmd": ["rider"],
        "flatpak": ["com.jetbrains.Rider"]
      },
      "RubyMine": {
        "enabled": true,
          "cmd": ["rubymine"],
        "flatpak": []
      },
      "PhpStorm": {
        "enabled": true,
        "cmd": ["phpstorm"],
        "flatpak": ["com.jetbrains.PhpStorm"]
      },
      "DataGrip": {
        "enabled": true,
        "cmd": ["datagrip"],
        "flatpak": []
      },
      "RustRover": {
        "enabled": true,
        "cmd": ["rustrover"],
        "flatpak": ["com.jetbrains.RustRover"]
      }
    }
  },
  "open_terminal": {
    "terminals": {
      "Ptyxis": {
        "enabled": true,
        "cmd": ["ptyxis", "--new-window", "-d", "{path}"],
        "flatpak": ["app.devsuite.Ptyxis", "--new-window", "-d", "{path}"]
      },
      "Ghostty": {
        "enabled": true,
        "cmd": ["ghostty", "--working-directory={path}", "--gtk-single-instance=false"],
        "flatpak": []
      },
      "Kitty": {
        "enabled": true,
        "cmd": ["kitty", "{path}"],
        "flatpak": []
      },
      "Alacritty": {
        "enabled": true,
        "cmd": ["alacritty", "--working-directory", "{path}"],
        "flatpak": []
      },
      "WezTerm": {
        "enabled": true,
        "cmd": ["wezterm", "start", "--cwd", "{path}"],
        "flatpak": ["org.wezfurlong.wezterm", "start", "--cwd", "{path}"]
      },
      "Console": {
        "enabled": true,
        "cmd": ["kgx", "{path}"],
        "flatpak": []
      }
    },
    "collapse_menu": true
  },
  "checksum": {
    "enabled_algorithms": ["md5", "sha1", "sha256", "sha512"]
  }
}
